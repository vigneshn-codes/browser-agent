# Choose provider: anthropic | openai
LLM_PROVIDER=anthropic

# Supply the key for whichever provider you selected
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o

# Agent behavior
MAX_STEPS=25
OUTPUT_LANGUAGE=English
REQUIRE_CONFIRMATION=true
HEADLESS=false

# Persistent profile (reuse your logged-in sessions & cookies).
# Leave USER_DATA_DIR empty for a fresh ephemeral browser each run.
# To reuse your real Chrome logins, point it at a COPY of your Chrome profile
# and set BROWSER_CHANNEL=chrome. NOTE: the profile is locked while open —
# fully quit Chrome first, or use a dedicated/cloned profile dir.
#   macOS Chrome default:  ~/Library/Application Support/Google/Chrome
USER_DATA_DIR=
BROWSER_CHANNEL=

# How long browser_wait polls for load/render to settle (milliseconds).
WAIT_TIMEOUT_MS=10000
